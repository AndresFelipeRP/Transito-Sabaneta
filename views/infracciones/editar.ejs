<%- include('../partials/navbar') %>

<h1>✏️ Editar Infracción</h1>
<a href="/infracciones" class="btn btn-secondary">← Volver</a>

<div class="form-card">
    <form action="/infracciones/editar/<%= infraccion.id %>" method="POST">
        <div class="form-group">
            <label>Vehículo (no editable)</label>
            <input type="text" value="<%= infraccion.placa %> - <%= infraccion.marca %>" disabled>
        </div>
        <div class="form-group">
            <label>Fuente (no editable)</label>
            <input type="text" value="<%= infraccion.tipo_fuente.toUpperCase() %> - <%= infraccion.ubicacion %>" disabled>
        </div>
        <div class="form-group">
            <label>Fecha de Infracción</label>
            <input type="date" name="fecha_infraccion" value="<%= infraccion.fecha_infraccion.toISOString().split('T')[0] %>" required>
        </div>
        <div class="form-group">
            <label>Descripción</label>
            <textarea name="descripcion" rows="3" required><%= infraccion.descripcion %></textarea>
        </div>
        <div class="form-group">
            <label>Valor de la Multa ($)</label>
            <input type="number" name="valor_multa" step="0.01" value="<%= infraccion.valor_multa %>" required>
        </div>
        <button type="submit" class="btn btn-primary">💾 Guardar Cambios</button>
    </form>
</div>

<%- include('../partials/footer') %>