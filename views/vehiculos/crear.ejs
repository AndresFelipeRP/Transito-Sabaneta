<%- include('../partials/navbar') %>

<h1>➕ Nuevo Vehículo</h1>
<a href="/vehiculos" class="btn btn-secondary">← Volver</a>

<div class="form-card">
    <form action="/vehiculos/crear" method="POST">
        <div class="form-group">
            <label>Placa</label>
            <input type="text" name="placa" required>
        </div>
        <div class="form-group">
            <label>Marca</label>
            <input type="text" name="marca" required>
        </div>
        <div class="form-group">
            <label>Modelo</label>
            <input type="text" name="modelo" required>
        </div>
        <div class="form-group">
            <label>Tipo</label>
            <select name="tipo" id="tipo" onchange="toggleTipo()" required>
                <option value="">-- Seleccione --</option>
                <option value="automovil">Automóvil</option>
                <option value="moto">Moto</option>
                <option value="carro_pesado">Carro Pesado</option>
            </select>
        </div>

        <div id="campos-automovil" style="display:none">
            <div class="form-group">
                <label>Número de puertas</label>
                <input type="number" name="numero_puertas">
            </div>
            <div class="form-group">
                <label>Tipo de combustible</label>
                <input type="text" name="tipo_combustible">
            </div>
        </div>

        <div id="campos-moto" style="display:none">
            <div class="form-group">
                <label>Tipo de moto</label>
                <input type="text" name="tipo_moto">
            </div>
            <div class="form-group">
                <label>Cilindrada</label>
                <input type="number" name="cilindrada">
            </div>
        </div>

        <div id="campos-pesado" style="display:none">
            <div class="form-group">
                <label>Capacidad de carga (ton)</label>
                <input type="number" step="0.1" name="capacidad_carga">
            </div>
            <div class="form-group">
                <label>Tipo de carrocería</label>
                <input type="text" name="tipo_carroceria">
            </div>
        </div>

        <button type="submit" class="btn btn-primary">💾 Guardar</button>
    </form>
</div>

<script>
    function toggleTipo() {
        const tipo = document.getElementById('tipo').value;
        document.getElementById('campos-automovil').style.display = tipo === 'automovil' ? 'block' : 'none';
        document.getElementById('campos-moto').style.display = tipo === 'moto' ? 'block' : 'none';
        document.getElementById('campos-pesado').style.display = tipo === 'carro_pesado' ? 'block' : 'none';
    }
</script>

